{
  "manifest_version": 3,
  "name": "IPv6 Readiness Auditor",
  "version": "1.0.0",
  "description": "Full in-browser IPv6 website & dependency readiness auditor with live topology DAG, 4-stage OSI diagnostics, and 30-site benchmark.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open IPv6 Readiness Auditor Side Panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "webRequest",
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
