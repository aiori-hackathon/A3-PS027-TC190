{
  "manifest_version": 3,
  "name": "IPv6 Readiness Inspector",
  "version": "1.0.0",
  "description": "Inspects real-time IPv6 and IPv4 socket reachability of the active webpage and all sub-resource dependencies.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IPv6 Dependency Readiness",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webRequest",
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
